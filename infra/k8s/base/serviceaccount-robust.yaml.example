# ROBUST PROD — per-service IRSA / Workload Identity (commented, opt-in)
# Current: Deployment uses default ServiceAccount + node role AmazonEKSWorkerNodePolicy (all pods share)
# Prod: least-privilege ServiceAccount per microservice — uncomment to enable
---
# apiVersion: v1
# kind: ServiceAccount
# metadata:
#   name: order-service
#   namespace: ecommerce
#   annotations:
#     # AWS IRSA — must match aws_iam_role.irsa_order in infra/aws/main.tf (ROBUST section)
#     eks.amazonaws.com/role-arn: arn:aws:iam::123456789012:role/ecommerce-prod-order-irsa
#     # GCP Workload Identity — must match google_service_account.order_sa
#     # iam.gke.io/gcp-service-account: order-service@your-project.iam.gserviceaccount.com
# ---
# Then in Deployment spec:
# spec:
#   template:
#     spec:
#       serviceAccountName: order-service
#       # containers: - name: order-service ... env with secrets from External Secrets Operator
#       # vs current: no serviceAccountName, uses default
