# =============================================================================
# Customer Service — Environment Variables
# =============================================================================
# Copy this file to .env and adjust for your environment.
#   cp .env.example .env
# =============================================================================

# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/ecommerce?authSource=admin

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Timeouts
TIMEOUT_MS=30000
