# =============================================================================
# Order Service — Environment Variables
# =============================================================================
# Copy this file to .env and adjust for your environment.
#   cp .env.example .env
# =============================================================================

# Server
PORT=5003
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/ecommerce?authSource=admin

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50

# Timeouts
TIMEOUT_MS=30000

# Service URLs (internal Docker hostnames when running in compose)
CUSTOMER_SERVICE_URL=http://customer-service:5001
PRODUCT_SERVICE_URL=http://product-service:5002
PAYMENT_SERVICE_URL=http://payment-service:5004

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672

# HTTP Client Retries
MAX_RETRIES=3
RETRY_DELAY=5000
