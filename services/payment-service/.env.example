# =============================================================================
# Payment Service — Environment Variables
# =============================================================================
# Copy this file to .env and adjust for your environment.
#   cp .env.example .env
# =============================================================================

# Server
PORT=5004
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://admin:password@localhost:27017/ecommerce?authSource=admin

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Timeouts
TIMEOUT_MS=30000

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672

# Order Service URL (for worker callback)
ORDER_SERVICE_URL=http://order-service:5003

# Payment Processing
PAYMENT_TIMEOUT=10000

# Queue Names
TRANSACTION_QUEUE=transaction_queue
DEAD_LETTER_QUEUE=transaction_queue_dlq
