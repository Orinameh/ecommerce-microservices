# =============================================================================
# Docker Compose — Environment Variables
# =============================================================================
# Copy this file to .env and adjust for your environment.
#   cp .env.example .env
#
# Docker Compose automatically loads .env from the project root.
# =============================================================================

# Environment
NODE_ENV=development

# MongoDB - set a strong password, do not commit real credentials
MONGODB_URI=mongodb://admin:YOUR_STRONG_PASSWORD@mongodb:27017/ecommerce?authSource=admin

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://rabbitmq:5672

# Service Ports
CUSTOMER_SERVICE_PORT=5001
PRODUCT_SERVICE_PORT=5002
ORDER_SERVICE_PORT=5003
PAYMENT_SERVICE_PORT=5004
